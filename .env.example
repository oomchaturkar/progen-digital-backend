# Port the server listens on. Most hosts (Render, Railway) set this
# automatically — you usually don't need to set it yourself.
PORT=3000

# Secret key required to view submissions at GET /api/submissions.
# Change this to something long and random before deploying.
ADMIN_KEY=change-me

# Your Postgres connection string. For a free Supabase project:
# Supabase dashboard -> your project -> Connect -> copy the "Connection string"
# (URI format, using the pooler connection). It looks like:
# postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-xx-xxxx-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Once your site has a real domain, set this so only that domain can
# submit to the API (CORS). Leave unset during local development.
# Example: ALLOWED_ORIGIN=https://progendigital.com
ALLOWED_ORIGIN=
